# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local review scratch — generated photography and raw video kept next to the
# project while art direction is in flight. The approved, downsized assets live
# in ios/CMSNApp/CMSNApp/Resources/; these are the multi-hundred-megabyte
# originals behind them and are not worth carrying in history.
/review/

# Canonical generated project/plists are committed alongside project.yml.
# Keep per-user Xcode state and build output local.
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/
*.xcresult/

# Purchased third-party vector masters stay out of this public repo.
# Dre's licensed copies live only in his private local library or Creative Cloud.
# Opus activewear flats, including any nested copy under brand/:
brand/**/Opus*.ai
# Licensed vendor vector packages (Illustrator and EPS). CMSN's own approved
# identity assets in brand/identity/revision-02/ are SVG and PDF, so they are
# not matched here. The exceptions below also keep a future native master in
# that directory from being ignored.
*.ai
*.eps
!brand/identity/revision-02/**/*.ai
!brand/identity/revision-02/**/*.eps
