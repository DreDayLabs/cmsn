# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local review scratch — generated photography and raw video kept next to the
# project while art direction is in flight. The approved, downsized assets live
# in ios/CMSNApp/CMSNApp/Resources/; these are the multi-hundred-megabyte
# originals behind them and are not worth carrying in history.
/review/
